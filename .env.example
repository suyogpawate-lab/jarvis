# Copy to .env (or just run: python setup.py). Never commit .env.
# REQUIRED providers (JARVIS needs all four):
GROQ_API_KEYS=gsk_xxx,gsk_yyy
GEMINI_API_KEYS=
ANTHROPIC_API_KEYS=
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
JARVIS_GMAIL_1_EMAIL=you@gmail.com
JARVIS_GMAIL_1_APP_PASSWORD=abcdefghijklmnop
JARVIS_DEFAULT_EMAIL=you@gmail.com
JARVIS_HTTP_TOKEN=

# Optional search keys
BRAVE_SEARCH_API_KEY=
BING_SEARCH_API_KEY=
VERIPHONE_API_KEY=

# strict (default) = risky shell commands (delete, kill, uninstall...) need `approve <code>`; off = no guard
JARVIS_SHELL_POLICY=strict

# Speech output provider: edge (network) or piper (local native library + model)
JARVIS_TTS_PROVIDER=edge
# Optional Piper paths (configure with ./voice-config)
# JARVIS_PIPER_LIBRARY=/data/data/com.termux/files/usr/lib/libpiper.so
# JARVIS_PIPER_MODEL=/data/data/com.termux/files/home/piper_models/en_GB-alan-medium.onnx
# JARVIS_PIPER_CONFIG=/data/data/com.termux/files/home/piper_models/en_GB-alan-medium.onnx.json
# JARVIS_ESPEAK_DATA=/data/data/com.termux/files/usr/share/espeak-ng-data
