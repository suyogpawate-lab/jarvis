# Copy to .env (or just run: jarvis-setup). Never commit .env.
# Provider settings (configure only the providers you use; Groq is the fast-agent default):
GROQ_API_KEYS=
JARVIS_FAST_MODEL=openai/gpt-oss-120b
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_COMPLEX_MODEL=auto/best-reasoning

# Separate coding/programming agent CLI (not the JARVIS chat/reasoning model).
# Defaults to Claude Code. Configure with: jarvis-setup coding
# Supported presets: claude-code, codex. Cline, Freebuff, and other tools
# use their own CLI command template; {prompt} is required, {workspace} optional.
JARVIS_CODING_BACKEND=claude-code
JARVIS_CODING_COMMAND=claude -p {prompt}
JARVIS_CODING_WORKSPACE=~/jarvis
JARVIS_CODING_TIMEOUT=1800
JARVIS_GMAIL_1_EMAIL=
JARVIS_GMAIL_1_APP_PASSWORD=
JARVIS_DEFAULT_EMAIL=
# Optional legacy token; the loopback-only bridge no longer requires it.
JARVIS_HTTP_TOKEN=

# Optional social integrations (tokens belong only in private .env; never commit them)
# GitHub: notifications + repo star/unstar
# JARVIS_GITHUB_TOKEN=
# Reddit: OAuth feed reader (mature posts are filtered); no automated voting
# JARVIS_REDDIT_ACCESS_TOKEN=
# JARVIS_REDDIT_USER_AGENT=JARVIS/1.0 (personal feed reader)
# YouTube: OAuth; youtube.readonly for feed, youtube.force-ssl for rating actions
# JARVIS_YOUTUBE_ACCESS_TOKEN=
# Meta: Page token / Instagram professional token (scopes vary by operation)
# JARVIS_META_ACCESS_TOKEN=  # optional fallback only\n# JARVIS_FACEBOOK_PAGE_ACCESS_TOKEN=\n# JARVIS_INSTAGRAM_ACCESS_TOKEN=
# JARVIS_FACEBOOK_PAGE_ID=
# JARVIS_INSTAGRAM_USER_ID=
# JARVIS_INSTAGRAM_API_HOST=https://graph.instagram.com
# JARVIS_META_GRAPH_VERSION=v26.0
# LinkedIn: OAuth; member feed read is restricted and may be unavailable
# JARVIS_LINKEDIN_ACCESS_TOKEN=
# JARVIS_LINKEDIN_PERSON_URN=
# JARVIS_LINKEDIN_VERSION=202610

# Optional search keys
BRAVE_SEARCH_API_KEY=
BING_SEARCH_API_KEY=
VERIPHONE_API_KEY=

# strict (default) = risky shell commands (delete, kill, uninstall...) need `approve <code>`; off = no guard
JARVIS_SHELL_POLICY=strict

# Optional voice input defaults (keep these aligned with voice/listener.py and scripts/test_voice.py)
JARVIS_WAKE_THRESHOLD=0.40
JARVIS_CONVERSATION_TIMEOUT=20

# Speech output provider: edge, piper, say, sherpa, phonon, kokoro, or kitten
# Phonon setup: bash install.sh --with-phonon; default model folder is ~/phonon-model
# KittenTTS setup: bash install.sh --with-kitten (bundled JARVIS ONNX worker)
JARVIS_TTS_PROVIDER=edge
# Optional KittenTTS Pico settings; model downloads on first start and is cached locally.
# JARVIS_KITTEN_CACHE=$HOME/.cache/huggingface
# JARVIS_KITTEN_MODEL=KittenML/kitten-tts-2-pico
# JARVIS_KITTEN_OFFLINE=0
# JARVIS_KITTEN_SPEED=0.88
# KittenTTS Pico voice ID (30 built-in voices across 8 languages)
# JARVIS_KITTEN_VOICE=otis_en
# When JARVIS_TTS_PROVIDER=sherpa: alan (British) or bryce (American)
JARVIS_SHERPA_VOICE=alan
# Phonon voice: edwin (default), toby, aldric, trevor, hugh, spencer, bramwell, or default
JARVIS_PHONON_VOICE=edwin
# Optional Phonon overrides:
# JARVIS_PHONON_DIR=/data/data/com.termux/files/home/phonon-model
# JARVIS_PHONON_QUANT=q8
# JARVIS_PHONON_THREADS=4
# Piper assets and generated audio stay inside ~/jarvis (configure with ./voice-config)
# JARVIS_PIPER_LIBRARY=/data/data/com.termux/files/home/jarvis/lib/piper/libpiper.so
# JARVIS_PIPER_MODEL=/data/data/com.termux/files/home/jarvis/models/piper/en_GB-alan-medium.onnx
# JARVIS_PIPER_CONFIG=/data/data/com.termux/files/home/jarvis/models/piper/en_GB-alan-medium.onnx.json
# JARVIS_ESPEAK_DATA=/data/data/com.termux/files/home/jarvis/voice/data/espeak-ng-data
# JARVIS_PIPER_OUTPUT_DIR=/data/data/com.termux/files/home/jarvis/cache/piper

# Optional local MobileCLIP-S0 screen perception (model files are not committed).
# Raw screen frames stay on-device; only visual labels + Accessibility text go to Groq.
# JARVIS_VISION_ONNX=$HOME/jarvis/models/vision/mobileclip_s0_image_fp16.ort
# JARVIS_VISION_PROTOTYPES=$HOME/jarvis/models/vision/mobileclip_s0_prototypes.json

# Optional JARVIS live screen-cast ports (Android companion -> Termux localhost)
JARVIS_SCREEN_STREAM_PORT=21340
JARVIS_SCREEN_CONTROL_PORT=21341

# Optional local Kokoro-82M FP16 TTS (install with scripts/install_kokoro82m_termux.sh).
# Includes 54 v1.0 voices + 103 v1.1-zh voices. Only the selected voice's
# matching ONNX model is loaded into RAM; the other model stays on disk.
# JARVIS_TTS_PROVIDER=kokoro
# JARVIS_KOKORO_VOICE_MODE=auto  # auto, normal, or whisper
# JARVIS_KOKORO_NORMAL_VOICE=am_eric  # any of the 157 IDs shown by jarvis-setup
# JARVIS_KOKORO_WHISPER_VOICE=jarvis_whisper  # uses the selected normal voice
# JARVIS_KOKORO_BREATH_MIX=0.82
# JARVIS_KOKORO_THREADS=2

# Optional Composio Sessions / hosted HTTP MCP integration.
# Create a project API key in Composio; keep it only in this private .env.
# JARVIS exposes read-only app tools initially; write actions are not exposed over MCP.
# COMPOSIO_API_KEY=
# JARVIS_COMPOSIO_USER_ID=jarvis-local
# JARVIS_COMPOSIO_TOOLKITS=instagram,github,youtube,reddit,linkedin,facebook
# JARVIS_COMPOSIO_TIMEOUT=25
# JARVIS_COMPOSIO_API_BASE=https://backend.composio.dev
