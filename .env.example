# Copy to .env (or just run: python setup.py). Never commit .env.
# Provider settings (configure only the providers you use; Groq is the fast-agent default):
GROQ_API_KEYS=
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_EXPERT_MODEL=auto/best-reasoning
JARVIS_GMAIL_1_EMAIL=
JARVIS_GMAIL_1_APP_PASSWORD=
JARVIS_DEFAULT_EMAIL=
# Optional legacy token; the loopback-only bridge no longer requires it.
JARVIS_HTTP_TOKEN=

# Optional search keys
BRAVE_SEARCH_API_KEY=
BING_SEARCH_API_KEY=
VERIPHONE_API_KEY=

# strict (default) = risky shell commands (delete, kill, uninstall...) need `approve <code>`; off = no guard
JARVIS_SHELL_POLICY=strict

# Optional voice input defaults (keep these aligned with voice/listener.py and scripts/test_voice.py)
JARVIS_WAKE_THRESHOLD=0.40
JARVIS_CONVERSATION_TIMEOUT=20

# Speech output provider: edge, piper, say, sherpa, or phonon
# Phonon setup: bash install.sh --with-phonon; default model folder is ~/phonon-model
JARVIS_TTS_PROVIDER=edge
# When JARVIS_TTS_PROVIDER=sherpa: alan (British) or bryce (American)
JARVIS_SHERPA_VOICE=alan
# Phonon voice: edwin (default), toby, aldric, trevor, hugh, spencer, bramwell, or default
JARVIS_PHONON_VOICE=edwin
# Optional Phonon overrides:
# JARVIS_PHONON_DIR=/data/data/com.termux/files/home/phonon-model
# JARVIS_PHONON_QUANT=q8
# JARVIS_PHONON_THREADS=4
# Piper assets and generated audio stay inside ~/jarvis (configure with ./voice-config)
# JARVIS_PIPER_LIBRARY=/data/data/com.termux/files/home/jarvis/lib/piper/libpiper.so
# JARVIS_PIPER_MODEL=/data/data/com.termux/files/home/jarvis/models/piper/en_GB-alan-medium.onnx
# JARVIS_PIPER_CONFIG=/data/data/com.termux/files/home/jarvis/models/piper/en_GB-alan-medium.onnx.json
# JARVIS_ESPEAK_DATA=/data/data/com.termux/files/home/jarvis/voice/data/espeak-ng-data
# JARVIS_PIPER_OUTPUT_DIR=/data/data/com.termux/files/home/jarvis/cache/piper

# Optional JARVIS live screen-cast ports (Android companion -> Termux localhost)
JARVIS_SCREEN_STREAM_PORT=21340
JARVIS_SCREEN_CONTROL_PORT=21341
