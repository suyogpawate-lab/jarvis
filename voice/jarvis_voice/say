#!/data/data/com.termux/files/usr/bin/python3
import sys
import socket
import os

SOCKET_FILE = "/data/data/com.termux/files/usr/tmp/jarvis_tts.sock"
VALID_MODELS = ["alan", "bryce"]

if not os.path.exists(SOCKET_FILE):
    print("Error: Voice server is not running. Start with: python ~/jarvis_voice/server.py &")
    sys.exit(1)

args = sys.argv[1:]
if not args:
    print("Usage: say [optional_model] \"Text to speak\"")
    print(f"Models: {', '.join(VALID_MODELS)} (Default: alan)")
    sys.exit(0)

if args[0].lower() in VALID_MODELS:
    selected_model = args[0].lower()
    text = " ".join(args[1:])
else:
    selected_model = "alan"
    text = " ".join(args)

if not text.strip():
    text = "Standing by, sir."

payload = f"{selected_model}:::{text}"

client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
client.connect(SOCKET_FILE)
client.sendall(payload.encode("utf-8"))
client.close()
